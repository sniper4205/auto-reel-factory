const fs = require("fs");
const path = require("path");

async function buildTimeline(projectId) {

  const imageDir = path.join(__dirname, "../../assets/generated/ai-visuals");

  if (!fs.existsSync(imageDir)) {
    throw new Error("Image folder not found: " + imageDir);
  }

  const files = fs
    .readdirSync(imageDir)
    .filter(f => f.includes(projectId) && f.endsWith(".png"))
    .sort();

  let timeline = [];
  let time = 0;

  files.forEach((file) => {

    timeline.push({
      file: path.join(imageDir, file),
      start: time,
      duration: 3
    });

    time += 3;

  });

  return timeline;
}

module.exports = {
  buildTimeline
};
